<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- Universal Links + iOS password AutoFill sharing. Backed by
	     https://orestexpress.online/.well-known/apple-app-site-association
	     (applinks covers /driver and /driver/*, matching the Android
	     pathPrefix). Requires the Associated Domains capability to be enabled
	     on the App ID in the Apple Developer portal, or signing will fail. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:orestexpress.online</string>
		<string>webcredentials:orestexpress.online</string>
	</array>
</dict>
</plist>
